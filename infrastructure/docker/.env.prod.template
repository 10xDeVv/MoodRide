# MoodRide production environment template.
# Keep secrets out of git; copy to .env.prod locally.

# Database
POSTGRES_DB=moodride
POSTGRES_USER=moodride
POSTGRES_PASSWORD=replace-with-strong-password

# Redis
REDIS_PASSWORD=replace-with-strong-password

# Images
# GHCR namespaces must be lowercase.
GHCR_NAMESPACE=replace-with-lowercase-ghcr-namespace
IMAGE_TAG=v1

# API CORS
MOODRIDE_CORS_ALLOWED_ORIGINS=https://app.moodrides.com

# Frontend public values
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=replace-with-mapbox-token
NEXT_PUBLIC_API_BASE_URL=https://app.moodrides.com
NEXT_PUBLIC_WS_BASE_URL=wss://app.moodrides.com/ws

# OSRM dataset
OSRM_DATASET_BASENAME=new-brunswick-latest

