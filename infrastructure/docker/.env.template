# MoodRide docker baseline environment template.
# Copy to .env for local overrides.

# Core data services
POSTGRES_DB=moodride
POSTGRES_USER=moodride
POSTGRES_PASSWORD=change-me-dev-password
REDIS_PASSWORD=change-me-dev-password

# Frontend public runtime defaults
NEXT_PUBLIC_API_BASE_URL=http://localhost
NEXT_PUBLIC_WS_BASE_URL=http://localhost/ws
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=replace-with-mapbox-token

# OSRM routing dataset config
OSRM_PBF_FILE=new-brunswick-latest.osm.pbf
OSRM_DATASET_BASENAME=new-brunswick-latest

# Route worker OSRM endpoint (container network)
MOODRIDE_OSRM_BASE_URL=http://osrm:5000

